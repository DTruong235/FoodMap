@{
    ViewData["Title"] = "Thống Kê Doanh Thu Linh Hoạt";
    string selectedFilter = ViewBag.LoaiThoiGian ?? "7ngay";
}

<!-- Nhúng thư viện Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-success mb-1">
                <i class="bi bi-graph-up-arrow me-2"></i>BÁO CÁO THỐNG KÊ GIAN HÀNG
            </h3>
            <p class="text-muted small mb-0">Phân tích hiệu quả kinh doanh linh hoạt theo chu kỳ</p>
        </div>

        <!-- FORM BỘ LỌC THỜI GIAN -->
        <form method="get" asp-action="ThongKe" class="d-flex align-items-center gap-2 bg-white p-2 rounded-4 shadow-sm border">
            <label class="fw-bold text-muted small ps-2"><i class="bi bi-funnel text-success me-1"></i>Lọc theo:</label>
            <select name="loaiThoiGian" class="form-select form-select-sm border-0 fw-bold text-success bg-light rounded-pill" onchange="this.form.submit()">
                <option value="7ngay" selected="@(selectedFilter == "7ngay")">🗓️ 7 ngày gần nhất</option>
                <option value="tuan" selected="@(selectedFilter == "tuan")">📅 4 tuần gần đây</option>
                <option value="thang" selected="@(selectedFilter == "thang")">📊 12 tháng (Năm nay)</option>
                <option value="quy" selected="@(selectedFilter == "quy")">📈 4 Quý (Năm nay)</option>
            </select>
        </form>
    </div>

    <!-- 1. CÁC THẺ KPI TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-success">
                <span class="text-muted small fw-semibold">DOANH THU KỲ NÀY</span>
                <h3 class="fw-bold text-success mb-0 mt-1">@(((decimal)ViewBag.TongDoanhThu).ToString("N0")) đ</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-primary">
                <span class="text-muted small fw-semibold">TỔNG ĐƠN PHÁT SINH</span>
                <h3 class="fw-bold text-primary mb-0 mt-1">@ViewBag.TongDonHang</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-warning">
                <span class="text-muted small fw-semibold">ĐƠN CHỜ XÁC NHẬN</span>
                <h3 class="fw-bold text-warning mb-0 mt-1">@ViewBag.DonChoXacNhan</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-info">
                <span class="text-muted small fw-semibold">ĐƠN ĐÃ HOÀN THÀNH</span>
                <h3 class="fw-bold text-info mb-0 mt-1">@ViewBag.DonHoanThanh</h3>
            </div>
        </div>
    </div>

    <!-- 2. BIỂU ĐỒ ĐƯỜNG THEO MỐC THỜI GIAN ĐÃ CHỌN -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark m-0">
                <i class="bi bi-activity text-success me-2"></i>Biểu đồ Doanh thu
                <span class="text-success fs-6">
                    (@(selectedFilter == "tuan" ? "Theo Tuần" : selectedFilter == "thang" ? "Theo Tháng" : selectedFilter == "quy" ? "Theo Quý" : "7 Ngày gần đây"))
                </span>
            </h5>
            <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-1 fw-bold">Thống kê chuẩn xác</span>
        </div>
        <div style="position: relative; height: 320px; width: 100%;">
            <canvas id="revenueLineChart"></canvas>
        </div>
    </div>
</div>

<!-- SCRIPT KHỞI TẠO BIỂU ĐỒ CHART.JS -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const labels = @Html.Raw(ViewBag.ChartLabels);
        const data = @Html.Raw(ViewBag.ChartData);

        const ctx = document.getElementById('revenueLineChart').getContext('2d');

        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(25, 135, 84, 0.35)');
        gradient.addColorStop(1, 'rgba(25, 135, 84, 0.0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: data,
                    borderColor: '#198754',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    pointBackgroundColor: '#198754',
                    pointBorderColor: '#fff',
                    pointHoverRadius: 7,
                    pointRadius: 5,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let value = context.raw || 0;
                                return ' Doanh thu: ' + value.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                }
            }
        });
    });
</script>