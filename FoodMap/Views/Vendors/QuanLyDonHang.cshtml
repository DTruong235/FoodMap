@model IEnumerable<FoodMap.Models.Hoadon>

@{
    ViewData["Title"] = "Quản Lý Đơn Đặt Hàng Gian Hàng";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1">
                <i class="bi bi-receipt-cutoff me-2"></i>QUẢN LÝ ĐƠN ĐẶT HÀNG
            </h3>
            <p class="text-muted small mb-0">Theo dõi danh sách đơn hàng và trạng thái quy đổi Voucher của gian hàng</p>
        </div>
        <a asp-action="QuetQR" class="btn btn-success fw-bold rounded-pill px-3 shadow-sm">
            <i class="bi bi-qr-code-scan me-1"></i> Quét QR Quy Đổi
        </a>
    </div>

    <!-- BẢNG DANH SÁCH ĐƠN HÀNG -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-success">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Số Điện Thoại</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Tiền</th>
                        <th>Tiến Độ Xử Lý</th>
                        <th class="text-center">Thao Tác Xác Nhận</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var hd in Model)
                        {
                            <tr>
                                <td class="fw-bold text-success">#HD@(hd.MaHd)</td>
                                <td class="fw-bold text-dark">@(hd.Khachhang?.Ten ?? hd.Khachhang?.Email ?? "Du khách")</td>
                                <td><i class="bi bi-telephone me-1 text-muted"></i>@(hd.Khachhang.DienThoai ?? "Chưa cập nhật")</td>
                                <td><i class="bi bi-clock me-1 text-muted"></i>@hd.Ngay.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-danger">@(hd.TongTien?.ToString("N0") ?? "0") đ</td>
                                <td>
                                    @if (hd.TrangThai == 0)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-hourglass-split me-1"></i>Chờ xác nhận</span>
                                    }
                                    else if (hd.TrangThai == 1)
                                    {
                                        <span class="badge bg-primary rounded-pill px-3 py-2"><i class="bi bi-gear-wide-connected me-1"></i>Đã nhận & Đang xử lý</span>
                                    }
                                    else if (hd.TrangThai == 2)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i>Đã hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (hd.TrangThai == 0)
                                    {
                                        <form asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                            <input type="hidden" name="maHd" value="@hd.MaHd" />
                                            <input type="hidden" name="trangThaiMoi" value="1" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill fw-bold me-1">
                                                <i class="bi bi-check-lg"></i> Xác Nhận Đơn
                                            </button>
                                        </form>
                                        <form asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                            <input type="hidden" name="maHd" value="@hd.MaHd" />
                                            <input type="hidden" name="trangThaiMoi" value="3" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill fw-bold" onclick="return confirm('Bạn có chắc muốn hủy đơn này?');">
                                                <i class="bi bi-x-lg"></i> Hủy
                                            </button>
                                        </form>
                                    }
                                    else if (hd.TrangThai == 1)
                                    {
                                        <form asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                            <input type="hidden" name="maHd" value="@hd.MaHd" />
                                            <input type="hidden" name="trangThaiMoi" value="2" />
                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill fw-bold">
                                                <i class="bi bi-box-seam me-1"></i> Hoàn Thành
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không có thao tác</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>