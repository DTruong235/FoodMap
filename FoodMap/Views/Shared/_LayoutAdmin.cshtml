<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị FoodMap</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex">
        <aside class="sidebar-wrapper sidebar-admin text-white p-3">
            <div class="d-flex align-items-center gap-2 mb-4 px-2">
                <i class="bi bi-shield-check fs-4 text-warning"></i>
                <span class="fw-bold fs-5">ADMIN PORTAL</span>
            </div>

            <ul class="nav flex-column">
                <!-- Bảng điều khiển -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Bảng điều khiển
                    </a>
                </li>

                <!-- Quản lý Vùng miền -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Danhmucs" asp-action="Index">
                        <i class="bi bi-map me-2"></i> Quản lý Vùng miền
                    </a>
                </li>

                <!-- Quản lý Chủ đề -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Chudes" asp-action="Index">
                        <i class="bi bi-tags me-2"></i> Quản lý Chủ đề
                    </a>
                </li>

                <!-- Quản lý Đối tác Vendor -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Nhacungcaps" asp-action="Index">
                        <i class="bi bi-shop me-2"></i> Quản lý Gian hàng
                    </a>
                </li>

                <!--QUản lý Khách hàng-->

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Khachhangs" asp-action="Index">
                        <i class="bi bi-people me-2"></i> Quản lý Khách hàng
                    </a>
                </li>

                <!-- Quản lý Bài viết / Cẩm nang -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Tins" asp-action="Index">
                        <i class="bi bi-journal-text me-2"></i> Quản lý Bài viết
                    </a>
                </li>

                <!--Thống kê-->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Admin" asp-action="ThongKeDoanhThuVendor">
                        <i class="bi bi-graph-up-arrow me-2"></i> Thống kê Doanh thu Vendor
                    </a>
                </li>

                <!--Đăng xuất-->
                <li class="nav-item mt-3">
                    <a class="nav-link text-danger fw-bold" asp-controller="Khachhangs" asp-action="DangXuat">
                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                    </a>
            </nav>
        </aside>

        <div class="flex-grow-1 bg-light">
            <header class="bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
                <span class="badge bg-primary rounded-pill px-3 py-2">Admin</span>
            </header>

            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>