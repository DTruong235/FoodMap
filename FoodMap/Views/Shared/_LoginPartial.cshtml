@using Microsoft.AspNetCore.Http

@{
    var userName = Context.Session.GetString("UserName");
    var vendorId = Context.Session.GetInt32("VendorId");
    var userId = Context.Session.GetInt32("UserId");
}

<ul class="navbar-nav align-items-center ms-auto">
    @if (!string.IsNullOrEmpty(userName))
    {
        if (vendorId != null)
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle fw-bold d-flex align-items-center text-success" href="#" id="vendorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-shop fs-5 me-1"></i>
                    <span>@userName</span>
                    <span class="badge bg-success ms-2">Vendor</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-2" aria-labelledby="vendorDropdown">
                    <li>
                        <a class="dropdown-item fw-bold text-success" asp-controller="Vendors" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i>Cổng Quản lý Gian hàng
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger fw-bold" asp-controller="Nhacungcaps" asp-action="DangXuat">
                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất Gian hàng
                        </a>
                    </li>
                </ul>
            </li>
        }
        else if (userId != null)
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle fw-bold d-flex align-items-center text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle text-primary fs-5 me-1"></i>
                    <span>@userName</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-2" aria-labelledby="userDropdown">
                    <li>
                        <a class="dropdown-item" asp-controller="Khachhangs" asp-action="Details" asp-route-id="@userId">
                            <i class="bi bi-person me-2"></i>Thông tin tài khoản
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger fw-bold" asp-controller="Khachhangs" asp-action="DangXuat">
                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                        </a>
                    </li>
                </ul>
            </li>
        }
    }
    else
    {
        <li class="nav-item me-2">
            <a class="btn btn-outline-primary rounded-pill btn-sm px-3 fw-bold" asp-controller="Khachhangs" asp-action="DangNhap">
                <i class="bi bi-person me-1"></i> Đăng nhập Khách
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-outline-success rounded-pill btn-sm px-3 fw-bold" asp-controller="Nhacungcaps" asp-action="DangNhap">
                <i class="bi bi-shop me-1"></i> Đăng nhập Vendor
            </a>
        </li>
    }
</ul>