<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bản Đồ Ẩm Thực Việt Nam</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="sticky-header shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container-fluid ps-2 pe-3">
                <a class="navbar-brand fw-bold text-uppercase" asp-controller="Home" asp-action="Index" style="color: var(--customer-primary);">
                    <i class="bi bi-geo-alt-fill me-1"></i> FoodMap
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCustomer">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarCustomer">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @if (ViewBag.danhmuc != null)
                        {
                            @foreach (var cm in (List<FoodMap.Models.Danhmuc>)ViewBag.danhmuc)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                                        @cm.Ten
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-sm">
                                        @if (ViewBag.chude != null)
                                        {
                                            @foreach (var cd in (List<FoodMap.Models.Chude>)ViewBag.chude)
                                            {
                                                if (cd.MaDm == cm.MaDm)
                                                {
                                                    <li>
                                                        <a class="dropdown-item" asp-controller="Home" asp-action="Chude" asp-route-id="@cd.MaCd">
                                                            @cd.TenCd
                                                        </a>
                                                    </li>
                                                }
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Thanh tìm kiếm trung tâm -->
                    <form class="d-flex me-lg-4 my-2 my-lg-0" style="max-width: 380px; width: 100%;" asp-controller="Home" asp-action="Tim" method="get">
                        <div class="input-group">
                            <input class="form-control border-end-0 rounded-start-pill bg-light" type="search" name="tukhoa" placeholder="Tìm đặc sản, tour ẩm thực..." aria-label="Search">
                            <button class="btn btn-outline-secondary border-start-0 rounded-end-pill bg-light text-muted" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    @using Microsoft.AspNetCore.Http
                    @using System.Text.Json
                    @using FoodMap.Models

                    @{
                        int cartCount = 0;
                        var jsonCart = Context.Session.GetString("shopcart");
                        if (!string.IsNullOrEmpty(jsonCart))
                        {
                            try
                            {
                                var cartList = JsonSerializer.Deserialize<List<CartItem>>(jsonCart);
                                if (cartList != null)
                                {
                                    cartCount = cartList.Sum(i => i.SoLuong);
                                }
                            }
                            catch
                            {
                                cartCount = 0;
                            }
                        }
                    }

                    <!-- Giỏ hàng & Đăng nhập -->
                    <div class="d-flex align-items-center gap-2 text-nowrap">
                        <!-- NÚT GIỎ HÀNG THU NHỎ -->
                        <a asp-controller="Khachhangs" asp-action="XemGioHang" class="btn btn-sm btn-outline-dark rounded-pill position-relative px-3 py-1 text-nowrap">
                            <i class="bi bi-cart3 fs-6"></i>
                            <span class="ms-1 d-none d-md-inline small">Giỏ hàng</span>
                            @if (cartCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                    @cartCount
                                </span>
                            }
                        </a>

                        <!-- PHẦN ĐĂNG NHẬP -->
                        <div class="d-inline-block">
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container text-center text-md-start">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <h5 class="fw-bold" style="color: var(--customer-primary);">BẢN ĐỒ ẨM THỰC VÙNG MIỀN</h5>
                    <p class="text-muted small">Nền tảng quảng bá văn hóa ẩm thực và kết nối du lịch lữ hành toàn quốc.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-muted small">&copy; 2026 FoodMap Portal. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>