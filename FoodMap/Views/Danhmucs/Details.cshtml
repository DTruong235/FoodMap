@model FoodMap.Models.Danhmuc

@{
    ViewData["Title"] = "Chi tiết Vùng miền";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-primary">
                <i class="bi bi-info-circle me-2"></i>Chi tiết Vùng miền
            </h5>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Mã danh mục:</dt>
                <dd class="col-sm-8 fw-bold">#@Model.MaDm</dd>

                <dt class="col-sm-4 text-muted">Tên Vùng miền:</dt>
                <dd class="col-sm-8 fw-bold text-dark">@Model.Ten</dd>

            </dl>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
                <a asp-action="Edit" asp-route-id="@Model.MaDm" class="btn btn-warning text-white rounded-pill btn-sm px-4 fw-bold shadow-sm">
                    <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>