@model IEnumerable<FoodMap.Models.Danhmuc>

@{
    ViewData["Title"] = "Quản lý Vùng miền";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-primary mb-0">
            <i class="bi bi-map me-2"></i>QUẢN LÝ VÙNG MIỀN / DANH MỤC
        </h4>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm Vùng miền mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã</th>
                            <th>Tên Vùng miền / Danh mục</th>
                            <th class="text-center" style="width: 180px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Chưa có danh mục vùng miền nào.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">#@item.MaDm</td>
                                    <td class="fw-bold text-dark">@item.Ten</td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.MaDm" class="btn btn-sm btn-outline-warning rounded-circle me-1" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.MaDm" class="btn btn-sm btn-outline-info rounded-circle me-1" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaDm" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>