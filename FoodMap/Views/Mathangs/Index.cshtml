@model IEnumerable<FoodMap.Models.Mathang>

@{
    ViewData["Title"] = "Danh Sách Mặt Hàng & Tour";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-success mb-1">
                <i class="bi bi-box-seam me-2"></i>DANH SÁCH SẢN PHẨM & TOUR
            </h3>
            <p class="text-muted small mb-0">Quản lý danh mục đặc sản và gói trải nghiệm của gian hàng</p>
        </div>
        <a asp-action="Create" class="btn btn-success fw-bold rounded-pill px-3 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm Mặt Hàng Mới
        </a>
    </div>

    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMsg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-success text-dark">
                    <tr>
                        <th style="width: 80px;">Hình Ảnh</th>
                        <th>Tên Món Ăn / Tour</th>
                        <th>Chủ Đề</th>
                        <th>Giá Gốc</th>
                        <th>Giá Bán (Voucher)</th>
                        <th class="text-center" style="width: 150px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="~/images/@(string.IsNullOrEmpty(item.HinhAnh) ? "no-image.png" : item.HinhAnh)"
                                         alt="@item.Ten" class="rounded-3 shadow-sm object-fit-cover" style="width: 55px; height: 55px;" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Ten</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 260px;">@item.MoTa</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-success border border-success rounded-pill px-3 py-1">
                                        <i class="bi bi-tag me-1"></i>@(item.Chude?.TenCd ?? "Đặc sản")
                                    </span>
                                </td>
                                <td class="text-muted text-decoration-line-through">
                                    @(item.GiaGoc?.ToString("N0") ?? "0") đ
                                </td>
                                <td class="fw-bold text-danger fs-6">
                                    @(item.GiaBan?.ToString("N0") ?? "0") đ
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.MaMh" class="btn btn-outline-primary rounded-start-pill px-2" title="Sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.MaMh" class="btn btn-outline-info px-2" title="Xem">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaMh" class="btn btn-outline-danger rounded-end-pill px-2" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Chưa có mặt hàng nào. Bấm <strong>"Thêm Mặt Hàng Mới"</strong> để bắt đầu đăng bán!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>