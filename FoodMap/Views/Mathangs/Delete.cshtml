@model FoodMap.Models.Mathang

@{
    ViewData["Title"] = "Xác Nhận Xóa Mặt Hàng";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 p-4 bg-white text-center">
                <!-- ICON CẢNH BÁO MÀU ĐỎ -->
                <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                </div>

                <h4 class="fw-bold text-danger mb-2">XÁC NHẬN XÓA MẶT HÀNG?</h4>
                <p class="text-muted small mb-4">Bạn có chắc chắn muốn xóa mặt hàng này khỏi gian hàng? Thao tác này không thể khôi phục!</p>

                <!-- THẺ XEM TRƯỚC SẢN PHẨM SẮP XÓA -->
                <div class="bg-light p-3 rounded-4 mb-4 text-start border d-flex align-items-center gap-3">
                    <img src="~/images/@(string.IsNullOrEmpty(Model.HinhAnh) ? "no-image.png" : Model.HinhAnh)"
                         alt="@Model.Ten"
                         class="rounded-3 shadow-sm object-fit-cover border"
                         style="width: 70px; height: 70px;" />
                    <div>
                        <div class="fw-bold text-dark mb-1">@Model.Ten</div>
                        <span class="badge bg-light text-success border border-success rounded-pill px-2 py-1 small mb-1">
                            @(Model.Chude?.TenCd ?? "Đặc sản")
                        </span>
                        <div class="text-danger fw-bold small">
                            Giá bán: @(Model.GiaBan?.ToString("N0") ?? "0") đ
                        </div>
                    </div>
                </div>

                <!-- FORM GỬI THAO TÁC XÓA (POST) -->
                <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaMh" />

                    <a asp-controller="Vendors" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                        <i class="bi bi-x-circle me-1"></i> Hủy Bỏ
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-trash me-1"></i> Xác Nhận Xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>