@model IEnumerable<FoodMap.Models.Mathang>

@{
    ViewData["Title"] = "Bảng điều khiển Quản trị";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-3">
    <h4 class="fw-bold text-primary mb-4">
        <i class="bi bi-speedometer2 me-2"></i>BẢNG ĐIỀU HÀNH QUẢN TRỊ (ADMIN)
    </h4>

    <!-- 3 Thẻ chỉ số Thống kê chính -->
    <div class="row g-3 mb-4">
        <!-- 1. Tổng Doanh Thu -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-white-50 text-uppercase fw-bold">Tổng Doanh Thu Toàn Sàn</small>
                        <h3 class="fw-bold mb-0">@ViewBag.TongDoanhThu.ToString("N0") đ</h3>
                    </div>
                    <i class="bi bi-cash-stack fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <!-- 2. Tổng Gian Hàng (Vendor) -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-white-50 text-uppercase fw-bold">Tổng Gian Hàng (Vendor)</small>
                        <h3 class="fw-bold mb-0">@ViewBag.TongVendor</h3>
                    </div>
                    <i class="bi bi-shop fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <!-- 3. Tổng Mặt Hàng / Tour -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-info text-white p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-white-50 text-uppercase fw-bold">Tổng Mặt Hàng & Tour</small>
                        <h3 class="fw-bold mb-0">@ViewBag.TongMatHang</h3>
                    </div>
                    <i class="bi bi-box-seam fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- BẢNG 1: Danh sách Vendor mới tham gia -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-shop me-2 text-primary"></i>Gian hàng Vendor mới đăng ký
                    </h6>
                    <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên Gian hàng</th>
                                    <th>Email / SĐT</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.VendorMoi != null)
                                {
                                    foreach (var v in (List<FoodMap.Models.Nhacungcap>)ViewBag.VendorMoi)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">@v.TenCongTy</td>
                                            <td><small class="text-muted">@(v.Email ?? v.DienThoai ?? "—")</small></td>
                                            <td class="text-center">
                                                <a asp-action="DanhSachSanPhamVendor" asp-route-id="@v.MaNcc" class="btn btn-xs btn-outline-info rounded-pill btn-sm">
                                                    Xem SP
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- BẢNG 2: Sản phẩm / Tour mới đăng gần đây (Để Admin kiểm duyệt) -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-box-seam me-2 text-success"></i>Sản phẩm / Tour mới đưa lên sàn
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Sản phẩm</th>
                                    <th>Gian hàng</th>
                                    <th>Giá bán</th>
                                    <th class="text-center">Xem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="fw-bold text-dark d-block">@item.Ten</span>
                                            <small class="text-muted">@(item.Chude?.TenCd ?? "Chưa phân loại")</small>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@(item.Nhacungcap?.TenCongTy ?? "Gian hàng")</span></td>
                                        <td class="text-danger fw-bold">@(item.GiaBan?.ToString("N0") ?? "0")đ</td>
                                        <td class="text-center">
                                            <a asp-controller="Home" asp-action="Details" asp-route-id="@item.MaMh" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>