@{
    ViewData["Title"] = "Quét & Xác thực Voucher";
}

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-2 border-success">
        <div>
            <h3 class="fw-bold text-success mb-1">
                <i class="bi bi-qr-code-scan me-2"></i>XÁC THỰC & QUY ĐỔI VOUCHER
            </h3>
            <p class="text-muted small mb-0">Cổng dành cho Nhà cung cấp dịch vụ & Gian hàng đặc sản</p>
        </div>
        <a asp-controller="Vendor" asp-action="Index" class="btn btn-outline-success rounded-pill fw-bold">
            <i class="bi bi-speedometer2 me-1"></i> Bảng điều khiển
        </a>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI: CAMERA QUÉT QR & INPUT MANUALLY -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-camera me-2 text-success"></i>Quét mã QR từ du khách
                </h5>

                <div id="qr-reader" class="rounded-3 overflow-hidden border border-2 border-success mb-3" style="width: 100%; min-height: 250px; background: #f8f9fa;"></div>

                <div class="text-center mb-3">
                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Đưa camera hướng vào mã QR Voucher trên điện thoại du khách</small>
                </div>

                <hr class="my-3" />

                <h6 class="fw-bold text-secondary mb-2">Hoặc nhập tay mã Voucher:</h6>
                <div class="input-group">
                    <input type="text" id="inputMaVoucher" class="form-control form-control-lg text-uppercase fw-bold border-success" placeholder="VD: VOUCHER-A1B2C3D4" />
                    <button id="btnXacThucManual" class="btn btn-success fw-bold px-4" type="button">
                        <i class="bi bi-check2-circle me-1"></i> Xác nhận
                    </button>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: KẾT QUẢ ĐỐI SOÁT VOUCHER -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-receipt me-2 text-success"></i>Kết quả xác thực
                </h5>

                <div id="boxStandby" class="text-center py-5 text-muted">
                    <i class="bi bi-qr-code display-1 opacity-25"></i>
                    <p class="mt-3">Vui lòng quét mã QR hoặc nhập chuỗi mã Voucher để gạch nợ dịch vụ.</p>
                </div>

                <!-- ĐỐI SOÁT THÀNH CÔNG -->
                <div id="boxSuccess" class="d-none">
                    <div class="alert alert-success rounded-4 p-3 text-center mb-3">
                        <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-1"></i>
                        <h5 class="fw-bold text-success mb-0">XÁC THỰC THÀNH CÔNG!</h5>
                        <small class="text-success fw-bold" id="resCode">VOUCHER-XXXXXX</small>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-3">
                        <div class="mb-2">
                            <span class="text-muted small">Tên đặc sản / Gói Tour:</span>
                            <h6 class="fw-bold text-dark mb-0" id="resTenMon">---</h6>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <span class="text-muted small">Số lượng:</span>
                                <p class="fw-bold text-dark mb-0" id="resSoLuong">0</p>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small">Thành tiền:</span>
                                <p class="fw-bold text-danger mb-0" id="resThanhTien">0 đ</p>
                            </div>
                        </div>
                    </div>

                    <div class="border-top pt-2">
                        <p class="mb-1 text-muted small"><i class="bi bi-person me-1"></i> Du khách: <strong class="text-dark" id="resKhach">---</strong></p>
                        <p class="mb-1 text-muted small"><i class="bi bi-telephone me-1"></i> Điện thoại: <strong class="text-dark" id="resSdt">---</strong></p>
                        <p class="mb-0 text-muted small"><i class="bi bi-calendar-check me-1"></i> Ngày mua: <strong class="text-dark" id="resNgay">---</strong></p>
                    </div>
                </div>

                <!-- LỖI / VOUCHER ĐÃ DÙNG -->
                <div id="boxError" class="d-none">
                    <div class="alert alert-danger rounded-4 p-3 text-center mb-3">
                        <i class="bi bi-x-circle-fill text-danger fs-1 d-block mb-1"></i>
                        <h5 class="fw-bold text-danger mb-1" id="errTitle">MÃ VOUCHER KHÔNG HỢP LỆ</h5>
                        <p class="small mb-0" id="errMsg">Không tìm thấy mã này trong hệ thống.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        function processVoucher(code) {
            if (!code) return;

            document.getElementById("boxStandby").classList.add("d-none");
            document.getElementById("boxSuccess").classList.add("d-none");
            document.getElementById("boxError").classList.add("d-none");

            fetch('/Vendor/XacThucVoucher', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ 'maVoucher': code })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById("resCode").innerText = data.maVoucher;
                    document.getElementById("resTenMon").innerText = data.tenMon;
                    document.getElementById("resSoLuong").innerText = data.soLuong;
                    document.getElementById("resThanhTien").innerText = data.thanhTien + " đ";
                    document.getElementById("resKhach").innerText = data.tenKhach;
                    document.getElementById("resSdt").innerText = data.dienthoai;
                    document.getElementById("resNgay").innerText = data.ngayDat;
                    document.getElementById("boxSuccess").classList.remove("d-none");
                } else {
                    document.getElementById("errTitle").innerText = data.isUsed ? "VOUCHER ĐÃ SỬ DỤNG" : "XÁC THỰC THẤT BẠI";
                    document.getElementById("errMsg").innerText = data.message;
                    document.getElementById("boxError").classList.remove("d-none");
                }
            })
            .catch(err => {
                console.error(err);
                alert("Lỗi kết nối máy chủ đối soát!");
            });
        }

        document.getElementById("btnXacThucManual").addEventListener("click", function () {
            var code = document.getElementById("inputMaVoucher").value;
            processVoucher(code);
        });

        function onScanSuccess(decodedText, decodedResult) {
            document.getElementById("inputMaVoucher").value = decodedText;
            processVoucher(decodedText);
        }

        let html5QrcodeScanner = new Html5QrcodeScanner(
            "qr-reader",
            { fps: 10, qrbox: { width: 200, height: 200 } },
            false
        );
        html5QrcodeScanner.render(onScanSuccess);
    });
</script>