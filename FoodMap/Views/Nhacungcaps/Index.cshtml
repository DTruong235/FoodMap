@model IEnumerable<FoodMap.Models.Nhacungcap>

@{
    ViewData["Title"] = "Quản lý & Phê duyệt Gian hàng Vendor";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-primary mb-0">
            <i class="bi bi-shop me-2"></i>QUẢN LÝ & PHÊ DUYỆT GIAN HÀNG VENDOR
        </h4>
        <!-- Không còn nút Thêm mới ở đây vì Vendor tự đăng ký từ ngoài -->
        <span class="badge bg-primary fs-6">Tổng số: @Model.Count() gian hàng</span>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã</th>
                            <th>Tên Gian hàng</th>
                            <th>Mã số thuế / MST</th>
                            <th>Người đại diện</th>
                            <th>Email / SĐT</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center" style="width: 220px;">Hành động Admin</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-muted">#@item.MaNcc</td>
                                <td class="fw-bold text-primary">@item.TenCongTy</td>
                                <td><small class="fw-bold text-muted">@(item.MaSoThue ?? "—")</small></td>
                                <td>@(item.NguoiDaiDien ?? "—")</td>
                                <td>
                                    <small class="d-block text-dark fw-bold">@item.Email</small>
                                    <small class="text-muted">@item.DienThoai</small>
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThaiXacThuc == 0)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>Chờ Admin duyệt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>Đã xác thực
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <!-- Nút Phê duyệt cho Admin -->
                                    @if (item.TrangThaiXacThuc == 0)
                                    {
                                        <form asp-controller="Nhacungcaps" asp-action="DuyetVendor" asp-route-id="@item.MaNcc" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm me-1"
                                                    onclick="return confirm('Xác nhận PHÊ DUYỆT gian hàng này?');">
                                                <i class="bi bi-check-lg me-1"></i> Duyệt
                                            </button>
                                        </form>
                                    }

                                    <a asp-action="Details" asp-route-id="@item.MaNcc" class="btn btn-sm btn-outline-info rounded-circle me-1" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaNcc" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
