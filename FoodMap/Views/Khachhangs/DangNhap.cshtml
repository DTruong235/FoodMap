@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center my-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h3 class="fw-bold text-center mb-3" style="color: var(--customer-primary);">
                <i class="bi bi-box-arrow-in-right me-2"></i>ĐĂNG NHẬP
            </h3>
            <hr />

            @if (TempData["SuccessMsg"] != null)
            {
                <div class="alert alert-success rounded-3 mb-3">@TempData["SuccessMsg"]</div>
            }

            @if (ViewBag.ThongBaoLoi != null)
            {
                <div class="alert alert-danger rounded-3 mb-3">@ViewBag.ThongBaoLoi</div>
            }

            <form asp-action="DangNhap" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input type="email" name="email" class="form-control" placeholder="Nhập email..." required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mật khẩu</label>
                    <input type="password" name="matkhau" class="form-control" placeholder="Nhập mật khẩu..." required />
                </div>

                <button type="submit" class="btn btn-warning fw-bold w-100 py-2 rounded-pill mt-2">
                    ĐĂNG NHẬP
                </button>
            </form>

            <div class="text-center mt-3">
                <small class="text-muted">Chưa có tài khoản? <a asp-action="Create" class="fw-bold text-warning">Đăng ký ngay</a></small>
            </div>
        </div>
        <!-- Nút/Option chuyển sang Đăng nhập Gian hàng -->
        <div class="card-footer bg-light text-center py-3 border-0">
            <span class="small text-muted">Bạn là Cơ sở kinh doanh / Đối tác?</span>
            <a asp-controller="Nhacungcaps" asp-action="DangNhap" class="btn btn-sm btn-outline-success rounded-pill ms-2 fw-bold">
                <i class="bi bi-shop me-1"></i> Đăng nhập Cổng Vendor
            </a>
        </div>
    </div>
</div>