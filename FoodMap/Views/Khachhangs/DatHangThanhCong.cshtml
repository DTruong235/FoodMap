@model FoodMap.Models.Hoadon

@{
    ViewData["Title"] = "Đặt hàng Thành công";
}

<div class="text-center py-5 my-3 card shadow-sm border-0 rounded-4 p-4">
    <i class="bi bi-check-circle-fill text-success display-1 mb-3"></i>
    <h2 class="fw-bold text-success">ĐẶT HÀNG THÀNH CÔNG!</h2>
    <p class="text-muted">Cảm ơn bạn đã lựa chọn khám phá ẩm thực cùng <strong>FoodMap</strong>.</p>

    <div class="alert alert-info d-inline-block text-start my-3 px-4 py-3 rounded-3" style="max-width: 500px;">
        <p class="mb-1"><strong>Mã hóa đơn:</strong> #@Model.MaHd</p>
        <p class="mb-1"><strong>Ngày đặt:</strong> @Model.Ngay.ToString("dd/MM/yyyy HH:mm")</p>
        <p class="mb-1"><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@(Model.TongTien?.ToString("N0")) đ</span></p>
        <p class="mb-0 text-success fw-bold"><i class="bi bi-qr-code me-1"></i> Mã Voucher điện tử đã được tạo thành công trong hệ thống!</p>
    </div>

    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-warning fw-bold rounded-pill px-4 me-2">
            Trở về Trang chủ
        </a>
    </div>
</div>