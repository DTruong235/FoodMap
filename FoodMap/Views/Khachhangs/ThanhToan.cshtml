@model List<FoodMap.Models.CartItem>

@{
    ViewData["Title"] = "Xác nhận Thanh toán";
    int tongtien = Model.Sum(i => (i.MatHang.GiaBan ?? 0) * i.SoLuong);
}

<div class="row g-4 my-2">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h4 class="fw-bold mb-3" style="color: var(--customer-primary);">THÔNG TIN NHẬN HÀNG / ĐẶT TOUR</h4>
            <form asp-controller="Khachhangs" asp-action="ThanhToan" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Họ và tên du khách *</label>
                    <input type="text" name="hoten" class="form-control" placeholder="Nguyễn Văn A" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Số điện thoại *</label>
                    <input type="tel" name="dienthoai" class="form-control" placeholder="0901234567" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Email nhận mã Voucher *</label>
                    <input type="email" name="email" class="form-control" placeholder="example@gmail.com" required />
                </div>
                <button type="submit" class="btn btn-warning fw-bold w-100 py-2 rounded-pill mt-3">
                    XÁC NHẬN ĐẶT HÀNG & NHẬN VOUCHER
                </button>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-light">
            <h5 class="fw-bold mb-3">ĐƠN HÀNG CỦA BẠN</h5>
            <ul class="list-group list-group-flush mb-3">
                @foreach (var item in Model)
                {
                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                        <div>
                            <h6 class="my-0">@item.MatHang.Ten</h6>
                            <small class="text-muted">SL: @item.SoLuong x @(item.MatHang.GiaBan?.ToString("N0")) đ</small>
                        </div>
                        <span class="fw-bold text-danger">@(((item.MatHang.GiaBan ?? 0) * item.SoLuong).ToString("N0")) đ</span>
                    </li>
                }
            </ul>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <span class="fw-bold fs-5">TỔNG CỘNG:</span>
                <strong class="text-danger fs-4">@tongtien.ToString("N0") đ</strong>
            </div>
        </div>
    </div>
</div>