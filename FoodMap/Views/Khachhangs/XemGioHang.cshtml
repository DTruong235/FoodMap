@model List<FoodMap.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng đặc sản & Voucher";
}

<div class="card shadow-sm border-0 rounded-4 p-4 my-3">
    <h3 class="fw-bold text-uppercase mb-3" style="color: var(--customer-primary);">
        <i class="bi bi-cart-check me-2"></i>Giỏ Hàng Của Bạn
    </h3>
    <hr />

    @if (Model.Count > 0)
    {
        int stt = 1;
        int tongtien = 0;

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-warning">
                    <tr>
                        <th>STT</th>
                        <th>Đặc sản / Voucher</th>
                        <th>Đơn giá</th>
                        <th style="width: 150px;">Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        int thanhtien = (i.MatHang.GiaBan ?? 0) * i.SoLuong;
                        tongtien += thanhtien;
                        <tr>
                            <td>@(stt++)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="~/images/@(string.IsNullOrEmpty(i.MatHang.HinhAnh) ? "default.jpg" : i.MatHang.HinhAnh)"
                                         class="rounded-3 object-fit-cover" width="60" height="60"
                                         onerror="this.onerror=null; this.src='/images/default.jpg';" />
                                    <div>
                                        <strong class="d-block text-dark">@i.MatHang.Ten</strong>
                                        <small class="text-muted">Mã món: #@i.MatHang.MaMh</small>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-bold">@(i.MatHang.GiaBan?.ToString("N0") ?? "0") đ</td>
                            <td>
                                <form asp-controller="Khachhangs" asp-action="CapNhatGioHang" method="post" class="d-flex align-items-center gap-1">
                                    <input name="id" type="hidden" value="@i.MatHang.MaMh" />
                                    <input name="quantity" type="number" min="1" value="@i.SoLuong" class="form-control form-control-sm text-center" />
                                    <button class="btn btn-outline-warning btn-sm" type="submit" title="Cập nhật">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="fw-bold text-danger">@thanhtien.ToString("N0") đ</td>
                            <td>
                                <a asp-controller="Khachhangs" asp-action="XoaGioHang" asp-route-id="@i.MatHang.MaMh" class="btn btn-outline-danger btn-sm rounded-pill">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn món
            </a>
            <div class="text-end">
                <h5 class="mb-2">Tổng tiền: <strong class="text-danger fs-3">@tongtien.ToString("N0") đ</strong></h5>
                <a asp-controller="Khachhangs" asp-action="ThanhToan" class="btn btn-warning fw-bold text-dark px-4 py-2 rounded-pill shadow-sm">
                    Tiến hành Thanh toán <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x text-muted display-1"></i>
            <h5 class="mt-3 text-muted">Giỏ hàng của bạn hiện đang rỗng!</h5>
            <a asp-controller="Home" asp-action="Index" class="btn btn-warning fw-bold rounded-pill mt-3 px-4">
                Khám phá đặc sản ngay
            </a>
        </div>
    }
</div>