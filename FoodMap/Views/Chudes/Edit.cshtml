@model FoodMap.Models.Chude

@{
    ViewData["Title"] = "Chỉnh sửa Chủ đề";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-primary">
                <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa Chủ đề
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaCd" />

                <div class="mb-3">
                    <label asp-for="TenCd" class="form-label fw-bold">Tên Chủ đề <span class="text-danger">*</span></label>
                    <input asp-for="TenCd" class="form-control" />
                    <span asp-validation-for="TenCd" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaDm" class="form-label fw-bold">Thuộc Vùng miền / Danh mục</label>
                    <select asp-for="MaDm" class="form-select" asp-items="ViewBag.MaDm"></select>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill btn-sm px-4 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i> Cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
