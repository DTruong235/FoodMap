@model FoodMap.Models.Chude

@{
    ViewData["Title"] = "Xóa Chủ đề";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card shadow-sm border-danger border-2 rounded-3">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>XÁC NHẬN XÓA
            </h5>
        </div>
        <div class="card-body p-4">
            <p class="text-muted mb-4">
                Bạn có chắc chắn muốn xóa Chủ đề này? Hành động này không thể hoàn tác!
            </p>

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Mã chủ đề:</dt>
                <dd class="col-sm-8 fw-bold">#@Model.MaCd</dd>

                <dt class="col-sm-4 text-muted">Tên Chủ đề:</dt>
                <dd class="col-sm-8 fw-bold text-danger">@Model.TenCd</dd>
            </dl>

            <form asp-action="Delete" class="d-flex justify-content-between align-items-center pt-3 border-top">
                <input type="hidden" asp-for="MaCd" />
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                    <i class="bi bi-arrow-left me-1"></i> Hủy bỏ
                </a>
                <button type="submit" class="btn btn-danger rounded-pill btn-sm px-4 fw-bold shadow-sm">
                    <i class="bi bi-trash me-1"></i> Đồng ý xóa
                </button>
            </form>
        </div>
    </div>
</div>